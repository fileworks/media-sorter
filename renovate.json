{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Central dependency-maintenance policy for fileworks repositories.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "prConcurrentLimit": 8,
  "branchConcurrentLimit": 8,
  "prHourlyLimit": 0,
  "schedule": [
    "before 5am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Batch routine maintenance into tested weekly patch releases. Updates no lane below claims stay in this fallback group.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly dependency updates",
      "groupSlug": "weekly-dependency-updates",
      "automerge": true,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Python lane: backend and CLI packages and uv.lock, independent of every other ecosystem.",
      "matchCategories": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly python updates",
      "groupSlug": "weekly-python-updates"
    },
    {
      "description": "JavaScript lane: frontend and release-tooling packages and their lockfiles.",
      "matchCategories": [
        "js"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly javascript updates",
      "groupSlug": "weekly-javascript-updates"
    },
    {
      "description": "Rust lane: native shell crates and Cargo.lock.",
      "matchCategories": [
        "rust"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly rust updates",
      "groupSlug": "weekly-rust-updates"
    },
    {
      "description": "CI lane: workflow actions and container images change how gates run, not what ships.",
      "matchCategories": [
        "ci",
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly ci updates",
      "groupSlug": "weekly-ci-updates"
    },
    {
      "description": "Tauri lane: crates and npm packages move together. The consumer's required checks must reject a npm/crate version mismatch before this lane can automerge.",
      "matchPackageNames": [
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "@tauri-apps/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "groupName": "weekly tauri updates",
      "groupSlug": "weekly-tauri-updates"
    },
    {
      "description": "Python resolution: lock in-range releases (a bare lower bound would otherwise never move uv.lock) and skip releases whose requires-python does not cover the project's.",
      "matchCategories": [
        "python"
      ],
      "rangeStrategy": "update-lockfile",
      "constraintsFiltering": "strict"
    },
    {
      "description": "Skip shipped npm dependencies whose engines do not cover the repository's Node range.",
      "matchCategories": [
        "js"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Renovate's documented workaround for npm lockfiles that one install leaves out of sync with package.json.",
      "matchManagers": [
        "npm"
      ],
      "postUpdateOptions": [
        "npmInstallTwice"
      ]
    },
    {
      "description": "Runtime versions set the supported platform; moving them is a product decision, never a batch item.",
      "matchDepNames": [
        "python",
        "node"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "dependencyDashboardApproval": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "runtime"
    },
    {
      "description": "A sub-major upper bound (such as <2.5 or <2.0.1) is a deliberate cap; updating under or past it needs a reviewer. Major-boundary caps (<9, <2.0.0) stay routine.",
      "matchCurrentValue": "/<=?\\s*\\d+(?:\\.0)*\\.0*[1-9]/",
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "dependencyDashboardApproval": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-capped"
    },
    {
      "description": "Require explicit review for breaking-risk dependency changes.",
      "matchUpdateTypes": [
        "major",
        "replacement",
        "rollback"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-major"
    }
  ],
  "vulnerabilityAlerts": {
    "description": [
      "DEC-05: an urgent lane for genuinely time-sensitive vulnerabilities.",
      "Every field below is set explicitly rather than inherited. Renovate's docs",
      "say vulnerability-alert PRs skip the routine queue and may ignore schedule",
      "and concurrency fields, but 'may ignore' is not a guarantee to build a",
      "security lane on, and an unset field would otherwise inherit the weekly",
      "lane's soak and automerge. These are declarative defence-in-depth: they do",
      "not prevent queueing, and nothing here claims they do."
    ],
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ],
    "groupName": null,
    "labels": [
      "security"
    ],
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0,
    "automerge": false,
    "dependencyDashboardApproval": false
  }
}
